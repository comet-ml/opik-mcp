{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make format)",
      "Bash(make conformance)",
      "Bash(make hermetic)",
      "Bash(make hermetic *)",
      "Bash(make skills-verify-source)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy)",
      "Bash(uv run mypy *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list)",
      "Bash(git fetch origin main)",
      "Bash(git fetch -q origin main)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.opik.config)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Edit(/.claude/skills/**)",
      "Edit(/.agents/skills/**)",
      "Edit(/src/opik_mcp/_version.py)",
      "Edit(/dist/**)",
      "Bash(git * --output*)",
      "Bash(git * --no-index*)",
      "Bash(git * --ext-diff*)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --exec*)",
      "Bash(git difftool*)",
      "Bash(git push * main *)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git -C * push*)"
    ],
    "ask": [
      "Bash(make live)",
      "Bash(make user-flows)",
      "Bash(make install-branch)",
      "Bash(make install-branch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_paths.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\""
          }
        ]
      }
    ]
  }
}
